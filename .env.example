# OpenAI-compatible endpoint for the fixed LLM agent.
# Point this at ANY provider that speaks the OpenAI chat/completions API.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Frozen decoding configuration (recorded into every trace).
RFQ_BENCH_MODEL=gpt-4o-mini
RFQ_BENCH_TEMPERATURE=0
# Raise for reasoning models — thinking eats the budget; too low truncates the
# move and it's counted as a (truncation) error.
RFQ_BENCH_MAX_TOKENS=4096
# Forwarded to the endpoint when it supports request-level seeding.
RFQ_BENCH_SEED=7
# Per-request timeout in seconds.
RFQ_BENCH_TIMEOUT=60
# Ask the endpoint to report real USD spend in usage.cost (OpenRouter supports
# this). Harmless elsewhere; set to false if an endpoint rejects the extra field.
RFQ_BENCH_INCLUDE_COST=true
# Strict function calling (function.strict + additionalProperties:false). Off by
# default — some providers return empty tool args under strict. Turn on only if
# your provider supports it and you want the extra schema enforcement.
RFQ_BENCH_STRICT_TOOL=false

# System-prompt overrides (markdown files). Unset -> auto-discover
# ./prompts/system[_<role>].md, else the packaged default. A general file applies
# to both sides; a per-role file wins for that side. See prompts/README.md.
# RFQ_BENCH_SYSTEM_PROMPT=prompts/system.md
# RFQ_BENCH_BUYER_SYSTEM_PROMPT=prompts/system_buyer.md
# RFQ_BENCH_SELLER_SYSTEM_PROMPT=prompts/system_seller.md

# Example OpenRouter setup:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# RFQ_BENCH_MODEL=openai/gpt-4o-mini
